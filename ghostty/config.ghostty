# tmux integration - send save-buffer command
keybind = cmd+s=text:\x01\x73

# tmux prefix to toggle zoom on current pane
keybind = cmd+b=text:\x01\x7a

# aesthetics
theme = "Gruvbox Light"
background-opacity = 0.95
background-blur=true
macos-titlebar-style = hidden
maximize = true
shell-integration-features = no-cursor
window-decoration = none
app-notifications = no-clipboard-copy

# typography
font-size = 10
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1
font-family = "JetBrains Mono"
font-feature = calt

# animation
custom-shader-animation = true
custom-shader = ~/.config/ghostty/shaders/cursor-shaders/ripple_cursor.glsl
# custom-shader = ~/.config/ghostty/shaders/ghostty-cursor-shaders/cursor_warp.glsl

